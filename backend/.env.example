# FastAPI Server Settings
PORT=8000
ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Configuration
POSTGRES_USER=groww_admin
POSTGRES_PASSWORD=groww_secure_pass
POSTGRES_DB=groww_signal_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://groww_admin:groww_secure_pass@localhost:5432/groww_signal_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Service API Keys (Zero-Hallucination Change Story Generator)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin SDK Configuration (Push Alerts)
# Paste the full minified service account JSON inside single quotes.
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"groww-signal","private_key_id":"...","private_key":"...","client_email":"..."}'

# PostHog Analytics Telemetry
POSTHOG_API_KEY=phc_your_backend_posthog_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Demo user used by the local dashboard
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
